{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stats-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "account_id": "556c237bf8cb62edb8f7b401499bb7a9",

  // Home-screen icons, manifest, and Apple splash screens — served directly at the
  // edge for matching paths (favicon.ico, manifest.webmanifest, /splash/*, etc.)
  // without touching the Worker. Generated by `npm run icons`.
  "assets": {
    "directory": "./public"
  },

  // D1: daily snapshots of traffic, referrers, and keywords
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stats-dashboard",
      "database_id": "2f5ea431-472e-462f-94a4-b396576c1a5b"
    }
  ],

  // Nightly pull at 13:00 UTC (~6am Pacific). There used to be a second cron
  // 10 minutes later for runBingDaily -- removed 2026-09-11 after confirming
  // Bing throttles every call routed through Cloudflare Workers' shared
  // egress IPs (ErrorCode 17 "ThrottleIP"), independent of this account, key,
  // or pacing: the identical call from a non-Cloudflare IP succeeded
  // instantly. Bing's pull now runs as a GitHub Actions workflow
  // (.github/workflows/bing-pull.yml, scripts/bing-pull.mjs) that POSTs
  // results to this Worker's /ingest-bing endpoint instead -- see the note on
  // runBingDaily in src/index.js.
  "triggers": {
    "crons": ["0 13 * * *"]
  },

  // Serve the dashboard from the custom domain.
  // If your API token lacks Workers-Routes/DNS edit, remove this block, deploy
  // to *.workers.dev, then add the custom domain in the Cloudflare dashboard.
  "routes": [
    { "pattern": "stats.davidveksler.com", "custom_domain": true }
  ],

  // Also serve on *.workers.dev. This zone's Bot Fight Mode (zone-wide, not
  // path-scoped on the Free plan) JS-challenges any non-browser client
  // hitting stats.davidveksler.com, including the GitHub Actions runner that
  // POSTs to /ingest-bing (.github/workflows/bing-pull.yml). workers.dev is
  // Cloudflare's own domain, not this zone, so it isn't behind that
  // challenge -- /ingest-bing (and /run-bing, /run) stay REFRESH_KEY-gated
  // regardless of which hostname reaches them. See the Bing paragraph in
  // AGENTS.md for the full story.
  "workers_dev": true,
  "preview_urls": false,

  "observability": { "enabled": true },

  "vars": {
    "NTFY_TOPIC": "david-stats-cf-serp"
  }

  // Secrets (set via `wrangler secret put`, NOT here):
  //   CF_API_TOKEN  — Cloudflare token with Account Analytics Read (GraphQL)
  //   GSC_SA_KEY    — Google service-account JSON key (whole file, one line)
}
